# Пример конфига для боевого сервера с HTTPS (Let's Encrypt или внутренний CA)
# Скопировать как default.conf и заменить:
#   - techportal.example.com → реальный домен
#   - /etc/nginx/certs/fullchain.crt и privkey.key → реальные пути к сертификатам

server {
    listen 80;
    server_name techportal.example.com;
    # Редирект всего HTTP → HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name techportal.example.com;
    client_max_body_size 20M;

    ssl_certificate     /etc/nginx/certs/fullchain.crt;
    ssl_certificate_key /etc/nginx/certs/privkey.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    server_tokens off;
    gzip on;
    gzip_types text/plain application/json application/javascript text/css;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Django API
    location /api/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # $remote_addr — реальный IP, не позволяет обойти rate-limit через X-Forwarded-For
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    # ComProxy update server — метаданные патчей для AgentService
    location /v2/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    # ComProxy HUB — приём телеметрии от AgentService на кассах
    location /printers/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Django admin — ограничен по IP (только внутренняя сеть)
    location /admin/ {
        allow 192.168.0.0/16;
        allow 10.0.0.0/8;
        deny all;
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Статика Django (collectstatic → volume static_volume → /static внутри nginx)
    location /static/ {
        alias /static/;
        expires 30d;
    }

    # FAQ вложения — принудительное скачивание, не открывать в браузере (защита от XSS)
    # ВАЖНО: должен быть ДО общего /media/
    location /media/faq/ {
        alias /media/faq/;
        add_header Content-Disposition "attachment" always;
        add_header X-Content-Type-Options "nosniff" always;
        types { }
        default_type application/octet-stream;
    }

    # Медиафайлы
    location /media/ {
        alias /media/;
        expires 7d;
    }

    # React SPA
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
